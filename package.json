{
  "name": "youtube-watch-later",
  "displayName": "YouTube Watch Later",
  "version": "0.6.3",
  "description": "Add YouTube videos to your Watch Later playlist with a single click.",
  "author": "dnwjn <hello@dnwjn.dev>",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv2",
    "postinstall": "wxt prepare",
    "build": "pnpm run build:chrome && pnpm run build:edge && pnpm run build:firefox",
    "build:chrome": "wxt build -b chrome && wxt zip -b chrome",
    "build:edge": "wxt build -b edge && wxt zip -b edge",
    "build:firefox": "wxt build -b firefox --mv2 && wxt zip -b firefox --mv2",
    "build:source": "./bin/build-source.sh",
    "lint": "eslint .",
    "pretty": "prettier --write src",
    "pretty:check": "prettier --check src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "all": "pnpm run lint && pnpm run pretty && pnpm run typecheck && pnpm run test",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "bump:patch": "pnpm version patch --no-git-tag-version",
    "bump:minor": "pnpm version minor --no-git-tag-version",
    "bump:major": "pnpm version major --no-git-tag-version"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "0.3.4",
    "@types/node": "26.6.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "@wxt-dev/auto-icons": "^1.1.2",
    "@wxt-dev/module-react": "^1.2.2",
    "auto-changelog": "^2.7.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11",
    "wxt": "^0.21.5"
  },
  "packageManager": "pnpm@11.15.1+sha512.81350b07e53c9538a02f1f2303b4290fa2d7be04e56e2a970c4cc4b417dc761de196edabd49d55c7dc9580db81007c44143e4e3d7e462b3000d23c255122d065"
}
